# Copy this file to server/.env and adjust. `.env` is git-ignored – never commit it.
# Everything in here is SERVER-SIDE ONLY. The browser bundle contains no secrets;
# the client fetches non-secret settings at runtime from GET /api/config.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin of the deployed site (no trailing slash). Used for canonical
# URLs, the sitemap, CORS and the CSRF origin check.
SITE_URL=http://localhost:3000

# Origin of the Vite dev server (ignored in production).
CLIENT_ORIGIN=http://localhost:5173

# Signs the session cookie and anti-spam form tokens. REQUIRED in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Storage locations (defaults are fine for local development)
# DB_PATH=./data/beatnest.sqlite
# MEDIA_DIR=./media
# CLIENT_DIST=../client/dist

# HTTPS: redirect http->https and send HSTS. Turn on in production behind a
# TLS-terminating proxy (nginx, Caddy, Render, Fly, Railway …).
ENFORCE_HTTPS=false
# Number of reverse proxies in front of the app (so req.ip / req.secure are right).
TRUST_PROXY=0

# Analytics (all consent-gated in the UI):
#   first-party  -> events stored in SQLite, view with `npm run report -w server`
#   plausible    -> set PLAUSIBLE_DOMAIN
#   ga4          -> set GA_MEASUREMENT_ID (G-XXXXXXXXXX)
#   none         -> analytics disabled
ANALYTICS_PROVIDER=first-party
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=
ANALYTICS_RETENTION_DAYS=90

# Anti-spam: forms submitted faster than this many ms are rejected.
MIN_FORM_FILL_MS=1500

# debug | info | warn | error
LOG_LEVEL=info
