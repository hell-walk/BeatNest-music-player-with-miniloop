# Client-side environment. EVERYTHING here is PUBLIC – Vite embeds VITE_* values
# in the JavaScript bundle. Never put API keys, tokens or passwords in this file.
# Runtime settings (site URL, analytics provider/ids) are fetched from
# GET /api/config, so normally nothing needs to be set here at all.

# Base path of the API. Leave as /api unless you host the API on another origin.
# VITE_API_BASE=/api

# Where the Vite dev server proxies /api and /media to.
# VITE_DEV_API_TARGET=http://localhost:3000
